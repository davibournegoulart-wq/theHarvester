  },
  "Instagram": {
    "url": "https://www.instagram.com/{}/",
    "error_type": "title_regex",
    "found_pattern": "\\(@?{}\\)"
  },
  "Pinterest": {
    "url": "https://www.pinterest.com/{}/",
    "error_type": "title_regex",
    "found_pattern": "\\({}\\) - Profile \\| Pinterest"
  },
  "Twitch": {
    "url": "https://www.twitch.tv/{}",
    "error_type": "title_not_generic",
    "generic_title": "Twitch"
  }
