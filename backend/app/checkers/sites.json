{
  "GitHub": {
    "url": "https://github.com/{}",
    "error_type": "status_code",
    "not_found_code": 404
  },
  "Twitter/X": {
    "url": "https://x.com/{}",
    "error_type": "status_code",
    "not_found_code": 404
  },
  "Steam": {
    "url": "https://steamcommunity.com/id/{}",
