# Copie pra .env (já no .gitignore, nunca vai pro GitHub) e preencha você mesmo.
# Nunca cole o valor real no chat/conversa com o Claude.

# Cookie da SUA PRÓPRIA sessão Google já logada (DevTools > Application > Cookies >
# google.com, valor de "SAPISID"). Ver checkers/google_account.py e README#Conta Google.
NETSCRAPER_GOOGLE_SESSION_COOKIES={"SAPISID":""}

# Chave gratuita cadastrada em https://www.opensanctions.org/api/
NETSCRAPER_OPENSANCTIONS_API_KEY=
